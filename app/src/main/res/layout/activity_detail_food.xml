<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    tools:context=".DetailFoodActivity"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGE -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/imgFood"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_baseline_fastfood_24" />

        </androidx.cardview.widget.CardView>

        <!-- INFO CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Class Name -->

                <TextView
                    android:id="@+id/txtFoodNameClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ComTam"
                    android:textColor="#777777"
                    android:textSize="14sp" />

                <!-- Food Name -->

                <TextView
                    android:id="@+id/txtFoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cơm Tấm"
                    android:textColor="#222222"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Category -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CATEGORY"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Món chính"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Calories -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="CALORIES"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCalories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="550"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Price -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="PRICE (VNĐ)"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="50000"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Description -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="MÔ TẢ"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLines="8"
                    android:text="Món cơm truyền thống Việt Nam..." />

                <!-- Divider -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#DDDDDD" />

                <!-- Ingredients -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NGUYÊN LIỆU"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Thịt heo&#10;• Trứng&#10;• Gạo"
                    android:textSize="16sp" />

                <!-- Recipe -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CÁCH CHẾ BIẾN"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRecipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Ướp thịt&#10;&#10;2. Nướng thịt&#10;&#10;3. Dùng với cơm"
                    android:textSize="16sp" />

                <!-- Tips -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="MẸO"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Nướng than sẽ ngon hơn&#10;• Ăn kèm đồ chua"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- BUTTON -->

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#4CAF50"
            android:text="UPDATE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>